generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String     @id @db.Uuid
  name      String
  createdAt DateTime   @default(now())
  users     User[]
  incidents Incident[]
}

model User {
  id          String   @id @db.Uuid
  tenantId    String   @db.Uuid
  email       String
  displayName String
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

model Incident {
  id        String    @id @db.Uuid
  tenantId  String    @db.Uuid
  severity  String
  riskScore Int
  status    String
  summary   String
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  alerts    Alert[]
}

model Alert {
  id         String   @id @db.Uuid
  incidentId String   @db.Uuid
  source     String
  payload    Json
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id])
}
